{
  "name": "@johntalton/i2c-bus-mahalli",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "keywords": [],
  "files": [
    "i2c-bus-mahalli.js",
    "index.js",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "import": "./i2c-bus-mahalli.js"
    },
    "./mahalli": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "napi": {
    "binaryName": "mahalli",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "napi build --platform --release --esm",
    "build:debug": "napi build --platform --esm",
    "build:arm64": "napi build --platform --release --esm --target aarch64-unknown-linux-gnu --use-napi-cross",
    "build:armv7": "napi build --platform --release --esm --target armv7-unknown-linux-gnueabihf --use-napi-cross",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "test": "node --test"
  },
  "devDependencies": {
    "@johntalton/and-other-delights": "^8.6.7",
    "@napi-rs/cli": "^3.9.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johntalton/i2c-bus-mahalli.git"
  }
}
